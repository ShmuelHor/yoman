# One image recipe for every Node service (SECURITY A10). Build from the
# repository root, naming the workspace under services/:
#
#   docker build -f docker/Dockerfile.service --build-arg SERVICE=sessions -t yoman-sessions .
#
# Run it read-only and without privileges:
#
#   docker run --read-only --tmpfs /tmp --cap-drop ALL \
#     --security-opt no-new-privileges --env-file .env yoman-sessions

# node:22-alpine, pinned to the multi-arch index digest.
ARG NODE_IMAGE=node:22-alpine@sha256:0e1754758c2df4cfa3e68d59e2e1b7374bb7fd9ea6328eaaacf15cc934af8202

FROM ${NODE_IMAGE} AS build
ARG SERVICE
WORKDIR /app

# Only the manifests, the shared packages and this one service. The rest of
# the repository (.env, apps, other services) never lands in a layer.
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/ packages/
COPY services/${SERVICE}/ services/${SERVICE}/

# Install scripts never run (CLAUDE.md, dependency rules). A developer's local
# node_modules or dist must not leak into the image either.
RUN test -n "${SERVICE}" \
  && find packages services \( -name node_modules -o -name dist \) -prune -exec rm -rf {} + \
  && npm ci --ignore-scripts --no-audit --no-fund \
  && npm run build --workspaces --if-present \
  && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM ${NODE_IMAGE} AS runtime
ARG SERVICE

# npm, corepack and yarn are build tools: removing them leaves less to patch and to exploit.
# The digest pins the base, but upstream rebuilds lag Alpine's security fixes
# (ST19 blocks fixed HIGH/CRITICAL CVEs), so the runtime takes them at build time.
RUN apk upgrade --no-cache \
  && rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
  /usr/local/bin/corepack /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

ENV NODE_ENV=production \
  HOST=0.0.0.0 \
  PORT=8080

WORKDIR /app
# Owned by root and not writable by the service user, even without --read-only.
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules/ node_modules/
COPY --from=build /app/packages/ packages/
COPY --from=build /app/services/${SERVICE}/ services/${SERVICE}/

WORKDIR /app/services/${SERVICE}
# Numeric IDs of the base image's `node` user, so the host and Kubernetes-style
# runAsNonRoot checks can verify the service never runs as root.
USER 1000:1000
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "/app/packages/service-kit/dist/healthcheck.js"]

# Node is PID 1 and service-kit handles SIGTERM itself.
CMD ["node", "dist/main.js"]
