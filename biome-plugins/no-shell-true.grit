language js

// Any shell value other than the literal `false` runs through a shell: `true`,
// a path such as '/bin/sh', or a variable (including the `{ shell }` shorthand)
// that may hold either. Also covers the assignment form `opts.shell = value`.
or {
  `shell: $value` where { $value <: not `false` },
  `$obj.shell = $value` where { $value <: not `false` },
  JsShorthandPropertyObjectMember(name=`shell`)
} as $option where {
  register_diagnostic(span=$option, message="Never spawn through a shell (SECURITY A7). Use execFile with an args array.")
}
