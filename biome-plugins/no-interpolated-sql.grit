language js

// Covers member calls (`db.query(...)`) and bare calls to a destructured or
// wrapped helper (`query(...)`).
or {
  `$client.$method($args)`,
  `$method($args)`
} where {
  $method <: or {
    `query`,
    `execute`
  },
  $args <: contains JsTemplateExpression() as $sql where { $sql <: contains JsTemplateElement() },
  register_diagnostic(span=$sql, message="Interpolated SQL is banned (SECURITY A8). Pass values as query parameters.")
}
