# Supply-chain hardening: no dependency runs code at install time.
#
# Three dev dependencies declare install scripts (`hasInstallScript` in
# package-lock.json). With scripts disabled none of them runs, and none is needed:
# - simple-git-hooks: its postinstall only writes the git hooks. We install them
#   explicitly with `npm run hooks:install` instead.
# - esbuild (via tsx and vite): its postinstall only verifies the native binary,
#   which npm already installs from the platform's optional dependency
#   (@esbuild/linux-x64 here).
# - fsevents (via tsx and vite, macOS only, never installed on Linux): ships a prebuilt
#   binary, so its node-gyp rebuild is unnecessary.
# A new dependency with an install script must be added to this list with the
# reason it is safe to skip, or rebuilt explicitly and documented.
ignore-scripts=true
engine-strict=true
save-exact=true
audit-level=moderate
fund=false
