# Secrets for a local Yoman install. Do not copy this file to .env:
# run `npm run setup`, which writes .env with random values and mode 0600.
# Every value below is a placeholder and is rejected by setup if used as is.

# Postgres superuser, used only by the init script
POSTGRES_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the sessions service
SESSIONS_DB_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the reports service
REPORTS_DB_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the battery service
BATTERY_DB_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the system service
SYSTEM_DB_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the focus service
FOCUS_DB_PASSWORD=change-me-run-npm-run-setup
# Postgres role of the gateway service
GATEWAY_DB_PASSWORD=change-me-run-npm-run-setup
# Bearer token the agent sends to the gateway (32 random bytes)
AGENT_TOKEN=change-me-run-npm-run-setup

# Optional, not a secret: how every container prints its logs. `pretty` (the
# default) is one readable line per entry; `json` suits grep and jq.
# LOG_FORMAT=pretty
