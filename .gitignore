# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets: only .env.example is ever committed
.env
.env.*
!.env.example

# Local data never leaves this machine. Anchored to the root so that source
# directories named data/ (services/x/src/data/) are still tracked.
/data/
/backups/
*.dump

# Key material, as defense in depth alongside gitleaks
*.pem
*.key
*.p12

# Tooling
.vite/
playwright-report/
test-results/
*.log
.DS_Store
