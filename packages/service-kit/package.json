{
  "name": "@yoman/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Fastify service runtime: logging with redaction, config, DB pool, migrations, validation.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/create-service.d.ts",
      "default": "./dist/create-service.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "kysely": "0.29.8",
    "node-pg-migrate": "7.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  },
  "bin": {
    "yoman-healthcheck": "./dist/healthcheck.js"
  }
}
